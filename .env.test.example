# Copy to .env.test (gitignored) and fill in. Used only by the Playwright E2E suite.

# ── Targets ──────────────────────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:5000/api

# ── Credentials ──────────────────────────────────────────────────────────────
# Admin must have role ADMIN or SUPER ADMIN (needed for Delete + Enable-Edit tests).
E2E_ADMIN_USERNAME=admin@ckd.local
E2E_ADMIN_PASSWORD=

# A normal / location-scoped user (no admin role) — for role-gating tests.
E2E_USER_USERNAME=
E2E_USER_PASSWORD=

# ── Write-test safety switch ─────────────────────────────────────────────────
# 0/unset  -> only read, filter, validation and role tests run (no backend writes).
# 1        -> also run Create / Update / Delete specs. With the LIVE backend these
#             write real rows to the shared production `Spaceage` RDS schema
#             (orgin + image tables). Every created shipment is soft-deleted after
#             the test and stamped with the prefix below.
ALLOW_WRITE_TESTS=0
E2E_TEST_PREFIX=E2ETEST-
